package ${bussPackage}.mapper;

import ${bussPackage}.entity.${className};
import ${bussPackage}.req.${fullLowerName}.ListReq;
import org.apache.ibatis.annotations.Mapper;
import java.util.List;
import org.apache.ibatis.annotations.Param;
import com.jiazm.practice.mapper.BaseMapper;

#if ($uniqueIndexColumns)
import java.math.BigDecimal;
import java.util.Date;
#end

/**
 * ${codeName} Mapper
 *
 * @author jiazm3
 * @date ${dateTime}
 */
@Mapper
public interface ${className}Mapper extends BaseMapper<${className}>{
    /**
     * 批量插入
     *
     * @return
     */
    Integer insertList(@Param("list") List<${className}> list);
    /**
     * 条件多选查询
     *
     * @return
     */
    List<${className}> selectByCondition(@Param("req") ListReq req);

}
